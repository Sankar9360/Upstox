TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_CHAT_ID=replace_me

UPSTOX_CLIENT_ID=replace_me
UPSTOX_CLIENT_SECRET=replace_me
UPSTOX_REDIRECT_URI=https://YOUR-RAILWAY-DOMAIN/callback

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=nifty_orb

PAPER_MODE=True
LIVE_TRADING=False

# Optional: AI-based news sentiment (falls back to keyword scoring if unset)
# Gemini is tried first (if key present), then Anthropic, then plain keywords.
GEMINI_API_KEY=replace_me_optional
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=replace_me_optional
